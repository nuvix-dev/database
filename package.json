{
  "name": "@nuvix/db",
  "version": "1.0.0-alpha.2",
  "description": "Modular and performant open source database library for Nuvix, with internal complexity abstracted from developers.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "nuvix-db": "dist/cli/generate-types.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun && bun build ./src/cli/generate-types.ts --outdir dist/cli --target bun && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.generated-types.json",
    "prepublishOnly": "rm -rf dist && bun run build && bun run typecheck",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "generate-types": "bun dist/cli/generate-types.js",
    "types:init": "bun dist/cli/generate-types.js --init",
    "types:watch": "bun dist/cli/generate-types.js --watch",
    "lint": "bun lint",
    "format": "bun format"
  },
  "dependencies": {},
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuvix-Tech/database.git"
  },
  "devDependencies": {
    "@nuvix/cache": "^2.0.0",
    "@types/bun": "^1.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "nuvix",
    "database",
    "typescript",
    "orm",
    "query-builder",
    "postgresql",
    "bun",
    "modular",
    "validation"
  ]
}
